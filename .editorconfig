# Keeps files identical on Windows, macOS, and Linux checkouts.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Trailing whitespace is a line break in Markdown.
[*.md]
trim_trailing_whitespace = false
