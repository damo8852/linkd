# Copy to .env and fill in. Names only here, never values.
# Every variable is documented in docs/reference/integrations.md.

# --- App (shipped inside the app binary, so public by definition) ---
# Only the Supabase URL and anon key belong here. Anything secret in an
# EXPO_PUBLIC_ variable is a leak: the anon key is safe only because RLS
# protects the data behind it.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Local Edge Function development only ---
# In staging and production these are set with `supabase secrets set` and never
# live in a file. Use Twilio test credentials and a sandbox dispatch provider
# locally: no real SMS, no real dispatch, ever, from a dev machine.
SUPABASE_SERVICE_ROLE_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
DISPATCH_PROVIDER=
DISPATCH_API_TOKEN=
